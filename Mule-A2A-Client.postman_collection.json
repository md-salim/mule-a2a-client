{
  "info": {
    "_postman_id": "a2a-mule-client-v1",
    "name": "Mule A2A Client — CI SF Account Agent",
    "description": "REST client for mule-a2a-client (port 8084). All requests go through the A2A Client facade which forwards them as JSON-RPC to mule-a2a-server (port 8083).\n\n**Flow:** Send Message → taskId auto-saved → use in Get Task / Cancel Task / Push Configs\n**Tip:** Run 'List All Tasks' to pick up an existing taskId from a previous session.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8084",
      "type": "string",
      "description": "mule-a2a-client base URL (port 8084)"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string",
      "description": "Auto-populated from Send Message or List Tasks responses"
    },
    {
      "key": "contextId",
      "value": "",
      "type": "string",
      "description": "Auto-populated from Send Message response"
    },
    {
      "key": "sfAccountId",
      "value": "0015g00000AbCdEFGH",
      "type": "string",
      "description": "Salesforce Account ID to use in Get/Update/Delete requests"
    },
    {
      "key": "pushCallbackUrl",
      "value": "https://webhook.site/your-unique-id",
      "type": "string",
      "description": "Webhook URL for A2A push notifications"
    },
    {
      "key": "pushBearerToken",
      "value": "test-token",
      "type": "string"
    },
    {
      "key": "pushConfigId",
      "value": "",
      "type": "string",
      "description": "Auto-populated from Create Push Notification Config response"
    }
  ],
  "item": [
    {
      "name": "1. Agent Discovery",
      "item": [
        {
          "name": "GET Agent Card",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function() { pm.response.to.have.status(200); });",
                  "pm.test(\"Has agent name\", function() { pm.expect(pm.response.json().name).to.be.a('string'); });",
                  "var b = pm.response.json();",
                  "if (b.name) console.log('[A2A-CLIENT] Agent: ' + b.name + ' | Skills: ' + (b.skills ? b.skills.length : 0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/v1/a2a-client/agent-card",
            "description": "Fetches the A2A Agent Card from the CI SF Account Agent Server via the client facade.\nReturns: name, description, capabilities, skills, supportedInterfaces."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Send Message",
      "description": "All Send Message requests auto-save taskId and contextId as collection variables.",
      "item": [
        {
          "name": "Send Message — List All Accounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function() { pm.response.to.have.status(200); });",
                  "pm.test(\"No error\", function() { pm.expect(pm.response.json()).to.not.have.property('error'); });",
                  "var b = pm.response.json();",
                  "var t = b.id ? b.id : null;",
                  "var c = b.contextId ? b.contextId : null;",
                  "if (t) {",
                  "    pm.collectionVariables.set('taskId', t);",
                  "    pm.collectionVariables.set('contextId', c || '');",
                  "    console.log('[A2A-CLIENT] taskId: ' + t + ' | state: ' + (b.status && b.status.state ? b.status.state : 'N/A'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
            "raw": "{\n  \"userMessage\": \"List all Salesforce accounts\"\n}",
              "options": { "raw": { "language": "json" } }
