    {
      "name": "3. Task Management",
      "description": "Get, list and cancel A2A tasks. 'List All Tasks' auto-saves the first taskId from the array.",
      "item": [
        {
          "name": "List All Tasks",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function() { pm.response.to.have.status(200); });",
                  "pm.test(\"No error\", function() { pm.expect(pm.response.json()).to.not.have.property('error'); });",
                  "pm.test(\"Has tasks array\", function() { pm.expect(pm.response.json()).to.have.property('tasks'); });",
                  "",
                  "// Auto-save first taskId from the tasks array",
                  "var b = pm.response.json();",
                  "var tasks = (b.tasks && Array.isArray(b.tasks)) ? b.tasks : [];",
                  "if (tasks.length > 0 && tasks[0].id) {",
                  "    pm.collectionVariables.set('taskId', tasks[0].id);",
                  "    pm.collectionVariables.set('contextId', tasks[0].contextId || '');",
                  "    console.log('[A2A-CLIENT] taskId from list[0]: ' + tasks[0].id + ' | state: ' + (tasks[0].status && tasks[0].status.state ? tasks[0].status.state : 'N/A'));",
                  "    console.log('[A2A-CLIENT] Total tasks found: ' + tasks.length);",
                  "} else {",
                  "    console.log('[A2A-CLIENT] No tasks found in response');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/a2a-client/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "a2a-client", "tasks"]
            },
            "description": "Lists all A2A tasks stored on the server.\n\n✅ AUTO-SAVES: taskId and contextId from tasks[0]\n\nUse this to pick up an existing taskId from a previous session.\nSupports optional query params: contextId, pageSize, historyLength"
          },
          "response": []
        },
        {
          "name": "List Tasks — With Context Filter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function() { pm.response.to.have.status(200); });",
                  "var b = pm.response.json();",
                  "var tasks = (b.tasks && Array.isArray(b.tasks)) ? b.tasks : [];",
                  "if (tasks.length > 0 && tasks[0].id) {",
                  "    pm.collectionVariables.set('taskId', tasks[0].id);",
                  "    pm.collectionVariables.set('contextId', tasks[0].contextId || '');",
                  "    console.log('[A2A-CLIENT] taskId from filtered list[0]: ' + tasks[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/a2a-client/tasks?contextId={{contextId}}&historyLength=5",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "a2a-client", "tasks"],
              "query": [
                { "key": "contextId", "value": "{{contextId}}", "description": "Filter by context ID" },
                { "key": "historyLength", "value": "5", "description": "Number of history entries to include" },
                { "key": "pageSize", "value": "10", "description": "Max tasks to return", "disabled": true }
              ]
            },
            "description": "Lists tasks filtered by contextId.\nUses: {{contextId}} (auto-saved from Send Message)"
          },
          "response": []
        },
        {
          "name": "Get Task by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function() { pm.response.to.have.status(200); });",
                  "pm.test(\"No error\", function() { pm.expect(pm.response.json()).to.not.have.property('error'); });",
                  "var b = pm.response.json();",
                  "if (b.id) {",
                  "    console.log('[A2A-CLIENT] Task: ' + b.id + ' | state: ' + (b.status && b.status.state ? b.status.state : 'N/A'));",
                  "    // Log artifacts if present",
                  "    if (b.artifacts && b.artifacts.length > 0) {",
                  "        console.log('[A2A-CLIENT] Artifacts: ' + b.artifacts.length);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/a2a-client/tasks/{{taskId}}?historyLength=10",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "a2a-client", "tasks", "{{taskId}}"],
              "query": [
                { "key": "historyLength", "value": "10" }
              ]
            },
            "description": "Retrieves full details of a specific task including status, artifacts, and history.\nUses: {{taskId}} (auto-saved from Send Message or List All Tasks)"
          },
          "response": []
        },
        {
          "name": "Subscribe To Task (SSE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"SSE 200\", function() { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "text/event-stream" }
            ],
            "url": "{{baseUrl}}/v1/a2a-client/tasks/{{taskId}}/subscribe",
            "description": "Reconnects to an existing SSE session for a task in WORKING state.\nReceives buffered events from where the connection was lost.\nUses: {{taskId}}"
          },
          "response": []
        },
        {
          "name": "Cancel Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function() { pm.response.to.have.status(200); });",
                  "pm.test(\"No error\", function() { pm.expect(pm.response.json()).to.not.have.property('error'); });",
                  "var b = pm.response.json();",
                  "if (b.status) {",
                  "    console.log('[A2A-CLIENT] Cancel result — state: ' + (b.status.state || 'N/A'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/v1/a2a-client/tasks/{{taskId}}/cancel",
            "description": "Cancels the specified A2A task.\nUses: {{taskId}} (auto-saved from Send Message or List All Tasks)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Push Notification Config",
      "description": "Manage push notification callbacks for A2A tasks.\nRequires: {{taskId}} (run Send Message or List All Tasks first)",
      "item": [
        {
          "name": "Create Push Notification Config",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
