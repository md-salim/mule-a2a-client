<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:a2a="http://www.mulesoft.org/schema/mule/a2a"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
         http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
         http://www.mulesoft.org/schema/mule/a2a  http://www.mulesoft.org/schema/mule/a2a/current/mule-a2a.xsd
         http://www.mulesoft.org/schema/mule/http  http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <!-- Configuration Properties -->
    <configuration-properties doc:id="config-props-01"
                               doc:name="Configuration Properties"
                               file="config.properties"/>

    <!-- ================================================================
         HTTP LISTENER CONFIG — A2A Client REST API on port 8084
         Exposes:
           GET  /v1/a2a-client/agent-card
           POST /v1/a2a-client/messages
           GET  /v1/a2a-client/tasks
           GET  /v1/a2a-client/tasks/{taskId}
           POST /v1/a2a-client/tasks/{taskId}/cancel
           POST /v1/a2a-client/tasks/{taskId}/push-notification-configs
           GET  /v1/a2a-client/tasks/{taskId}/push-notification-configs
    ================================================================ -->
    <http:listener-config doc:id="a2a-client-http-listener-cfg-01"
                          doc:name="A2A Client HTTP Listener Config"
                          name="A2A_Client_HTTP_Listener_Config">
        <http:listener-connection host="0.0.0.0" port="${http.port}"/>
    </http:listener-config>

    <!-- ================================================================
         A2A CLIENT CONFIG — mule4-a2a-connector 2.0.0 (client-side)
         Uses JSON-RPC binding to communicate with the CI SF Account Agent.
         agentUrl: full base URL of the A2A agent (resolves /rpc automatically)
    ================================================================ -->
    <a2a:client-config doc:id="a2a-client-cfg-01"
                       doc:name="A2A Client Config"
                       name="A2A_Client_Config">
		<a2a:http-json-client-connection agentUrl="${a2a.agent.url}" />
    </a2a:client-config>

    <!-- ================================================================
         GLOBAL ERROR HANDLER
    ================================================================ -->
    <error-handler doc:id="global-error-handler-01"
                   doc:name="Global Error Handler"
                   name="Global_Error_Handler">
        <!-- A2A task not found -->
        <on-error-propagate doc:name="A2A Task Not Found" type="A2A:TASK_NOT_FOUND">
            <set-variable variableName="httpStatus" value="404" doc:name="Set 404"/>
            <set-payload value="#[output application/json --- {message: 'Task not found: ' ++ (error.description default 'N/A')}]"
                         doc:name="404 Payload"/>
            <logger level="WARN" category="${logging.category}"
                    message="#[write({event:'GLOBAL',errorType:'A2A:TASK_NOT_FOUND',msg:(error.description default 'N/A')},'application/json')]"/>
        </on-error-propagate>
        <!-- A2A connectivity error -->
        <on-error-propagate doc:name="A2A Connectivity" type="A2A:CONNECTIVITY">
            <set-variable variableName="httpStatus" value="503" doc:name="Set 503"/>
            <set-payload value="#[output application/json --- {message: 'A2A agent server unreachable: ' ++ (error.description default 'N/A')}]"
                         doc:name="503 Payload"/>
            <logger level="ERROR" category="${logging.category}"
                    message="#[write({event:'GLOBAL',errorType:'A2A:CONNECTIVITY',msg:(error.description default 'N/A')},'application/json')]"/>
        </on-error-propagate>
        <!-- HTTP Timeout -->
        <on-error-propagate doc:name="HTTP Timeout" type="HTTP:TIMEOUT">
            <set-variable variableName="httpStatus" value="504" doc:name="Set 504"/>
            <set-payload value="#[output application/json --- {message: 'Request timed out waiting for A2A agent.'}]"
                         doc:name="504 Payload"/>
            <logger level="ERROR" category="${logging.category}"
                    message="#[write({event:'GLOBAL',errorType:'HTTP:TIMEOUT',msg:(error.description default 'N/A')},'application/json')]"/>
        </on-error-propagate>
        <!-- Validation / expression errors -->
        <on-error-propagate doc:name="Bad Request" type="MULE:EXPRESSION, MULE:VALIDATION">
            <set-variable variableName="httpStatus" value="400" doc:name="Set 400"/>
            <set-payload value="#[output application/json --- {message: 'Bad request: ' ++ (error.description default 'N/A')}]"
                         doc:name="400 Payload"/>
            <logger level="WARN" category="${logging.category}"
                    message="#[write({event:'GLOBAL',errorType:'MULE:BAD_REQUEST',msg:(error.description default 'N/A')},'application/json')]"/>
        </on-error-propagate>
        <!-- Catch-all -->
        <on-error-propagate doc:name="Any Other Error" type="ANY">
            <set-variable variableName="httpStatus" value="500" doc:name="Set 500"/>
            <set-payload value="#[output application/json --- {message: 'Internal server error: ' ++ (error.description default 'N/A')}]"
                         doc:name="500 Payload"/>
            <logger level="ERROR" category="${logging.category}"
                    message="#[write({event:'GLOBAL',errorType:(error.errorType.identifier default 'UNKNOWN'),msg:(error.description default 'N/A')},'application/json')]"/>
        </on-error-propagate>
    </error-handler>

</mule>